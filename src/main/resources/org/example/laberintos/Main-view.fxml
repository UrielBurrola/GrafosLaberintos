<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" stylesheets="@estilo.css" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.laberintos.MainController">
   <children>
      <Label alignment="CENTER" text="Laberinto">
         <font>
            <Font name="American Typewriter" size="26.0" />
         </font>
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </Label>
      <HBox prefHeight="27.0" prefWidth="560.0" spacing="40.0">
         <children>
            <Button fx:id="btnDFS" mnemonicParsing="false" onAction="#onDFSClick" text="DFS" />
            <Button fx:id="btnBFS" mnemonicParsing="false" onAction="#onBFSClick" text="BFS" />
            <Button fx:id="btnDijkstra" mnemonicParsing="false" onAction="#onDijkstraClick" text="Dijkastra" />
            <Button fx:id="btnTodos" mnemonicParsing="false" onAction="#onTodosClick" text="Todos" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCargarArchivo" mnemonicParsing="false" onAction="#cargarLaberinto" text="Cargar Archivo" />
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Pausa por paso:" />
            <Slider fx:id="sliderPausa" blockIncrement="5.0" max="300.0" min="5.0" prefWidth="220.0" value="30.0" />
            <Label fx:id="lblPausa" text="30 ms" />
         </children>
         <VBox.margin>
            <Insets bottom="15.0" left="20.0" right="20.0" />
         </VBox.margin>
      </HBox>
      <TextArea fx:id="areaCodigo" editable="false" promptText="Aqui se va a ver xd" wrapText="true" VBox.vgrow="ALWAYS">
         <font>
            <Font name="Monospaced Regular" size="13.0" />
         </font>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" />
         </VBox.margin>
      </TextArea>
   </children>
</VBox>
